<div class="bg-slate-950 px-4 py-10 text-slate-100 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-xl rounded-2xl border border-white/10 bg-white/[0.06] p-6 shadow-2xl shadow-black/20">
    <h1 class="text-3xl font-bold text-white">Add activity</h1>
    <p class="mt-2 text-sm text-slate-400">
      Activities can later have recurring schedules and individual sessions.
    </p>

    <%= form_with model: @activity, class: "mt-6 space-y-5" do |form| %>
      <% if @activity.errors.any? %>
        <div class="rounded-lg border border-red-400/30 bg-red-400/10 p-4 text-sm text-red-200">
          <p class="font-semibold">The activity could not be saved:</p>
          <ul class="mt-2 list-disc pl-5">
            <% @activity.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-sm font-medium text-slate-200" %>
        <%= form.text_field :name,
              required: true,
              autofocus: true,
              class: "mt-2 block w-full rounded-lg border-0 bg-slate-900 px-3 py-2.5 text-white ring-1 ring-inset ring-white/10 transition placeholder:text-slate-600 focus:ring-2 focus:ring-indigo-400" %>
      </div>

      <div>
        <%= form.label :description, class: "block text-sm font-medium text-slate-200" %>
        <%= form.text_area :description,
              rows: 3,
              class: "mt-2 block w-full rounded-lg border-0 bg-slate-900 px-3 py-2.5 text-white ring-1 ring-inset ring-white/10 transition placeholder:text-slate-600 focus:ring-2 focus:ring-indigo-400" %>
      </div>

      <div class="flex items-center justify-between gap-4">
        <%= link_to "Cancel", root_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-slate-300 transition hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-indigo-400" %>
        <%= form.submit "Create activity",
              class: "rounded-lg bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400" %>
      </div>
    <% end %>
  </div>
</div>
