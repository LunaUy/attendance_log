<div class="bg-slate-950 px-4 py-10 text-slate-100 sm:px-6 lg:px-8">
    <h1 class="mx-auto max-w-4xl text-3xl font-bold tracking-tight text-white sm:text-4xl">Activities Index</h1>
    <p class="sr-only">Find me in app/views/activities/index.html.erb</p>
    
    <div class="mx-auto mt-8 grid max-w-4xl gap-4 sm:grid-cols-2">
        <% @activities.each do |activity| %>
            <div class="flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/[0.06] p-5 shadow-lg shadow-black/10">
                <h2 class="min-w-0 truncate text-lg font-semibold text-white"><%= activity.name %></h2>
                <%= button_to "Delete Activity",
                    activity_path(activity),
                    method: :delete,
                    data: {
                        turbo_confirm: "This will permanently delete the activity, its attendances, and its schedules. Continue?"
                    },
                    class: "shrink-0 rounded-lg border border-red-400/30 bg-red-400/10 px-3 py-2 text-sm font-semibold text-red-200 transition hover:bg-red-400/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-400"
                %>
            </div>
        <% end %>
    </div>

</div>
