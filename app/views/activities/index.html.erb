<div class="min-h-screen bg-slate-950 px-4 py-10 text-slate-100 sm:px-6 lg:px-8">
    <h1 class="text-center text-4xl font-bold tracking-tight text-white">Attendance Log</h1>
    <div class="mx-auto mt-8 max-w-3xl rounded-2xl border border-white/10 bg-white/[0.06] p-6 shadow-2xl shadow-black/20 sm:p-8">
        <h2 class="mb-6 text-2xl font-semibold text-white">Check your attendance here :&#41;</h2>
        <% @activities.each do |activity| %>
            <%#
            Early = arrived ealier than 5 minutes before the scheduled time
            On Time = arrived within 5 minutes before or in the scheduled time
            Late = arrived at least 1 minute after the scheduled time
            Missed = did not attend the scheduled activity
            %>
            <div>
                <h3><%= activity.name %></h3>
                <select id="activity_<%= activity.id %>_status" name="activity_<%= activity.id %>_status" class="mt-2 block w-full rounded-md border-0 bg-white/5 py-1.5 pl-3 pr-10 text-white ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-indigo-400 sm:text-sm sm:leading-6">
                    <option value="">Seleccionar Estado</option>
                    <option value="early">Early</option>
                    <option value="on-time">On Time</option>
                    <option value="late">Late</option>
                    <option value="missed">Missed</option>
                </select>
            </div>
        <% end %>
        <div>
            <button type="button" class="mt-6 w-full rounded-lg bg-indigo-500 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400">Confirm Day</button>
        </div>
    </div>
    <footer class="mx-auto mt-8 max-w-3xl text-center text-sm text-slate-500">
        <a href="https://github.com/LunaUy/" target="_blank" rel="noreferrer" title="LunaUy" class="transition hover:text-indigo-300"><em>@LunaUy</em> GitHub</a>
    </footer>
</div>