<div class="bg-slate-950 px-4 py-10 text-slate-100 sm:px-6 lg:px-8">
    <h1 class="mx-auto max-w-xl text-3xl font-bold tracking-tight text-white sm:text-4xl">Register Attendance</h1>
    <%= form_with model: @attendance, class: "mx-auto mt-8 max-w-xl space-y-5 rounded-2xl border border-white/10 bg-white/[0.06] p-6 shadow-2xl shadow-black/20 sm:p-8" do |form| %>
        <% if @attendance.errors.any? %>
            <div role="alert" class="rounded-xl border border-red-400/30 bg-red-400/10 p-4 text-sm text-red-200">
                <p class="font-semibold">The attendance log could not be saved:</p>
                <ul class="mt-2 list-disc space-y-1 pl-5">
                    <% @attendance.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                    <% end %>
                </ul>
            </div>
        <% end %>

        <div class="space-y-2">
            <%= form.label :activity_id, "Corresponding Activity", class: "block text-sm font-medium text-slate-200" %>
            <%= form.collection_select :activity_id, @activities, :id, :name, { prompt: "Choose Activity" }, class: "block w-full rounded-lg border-0 bg-slate-900 px-3 py-2.5 text-slate-100 ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-indigo-400" %>
        </div>

        <div class="space-y-2">
            <%= form.label :scheduled_at, "Scheduled At", class: "block text-sm font-medium text-slate-200" %>
            <%= form.datetime_local_field :scheduled_at, step: 60, aria: { invalid: @attendance.errors[:scheduled_at].any? }, class: "block w-full rounded-lg border-0 bg-slate-900 px-3 py-2.5 text-slate-100 ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-indigo-400 aria-invalid:ring-2 aria-invalid:ring-red-400 [color-scheme:dark]" %>
            <% @attendance.errors.full_messages_for(:scheduled_at).each do |message| %>
                <p class="text-sm text-red-300"><%= message %></p>
            <% end %>
        </div>
        
        <div class="space-y-2">
            <%= form.label :status, "Select Status", class: "block text-sm font-medium text-slate-200" %>
            <%= form.select :status,
                [
                    ["Pending", ""],
                    ["Early", "early"],
                    ["On time", "on-time"],
                    ["Late", "late"],
                    ["Missed", "missed"]
                ],
                {},
                class: "block w-full rounded-lg border-0 bg-slate-900 px-3 py-2.5 text-slate-100 ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-indigo-400"
            %>
        </div>
        
        <div class="pt-2">
            <%= form.submit "Confirm Attendance", class: "w-full rounded-lg bg-indigo-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400" %>
        </div>
    <% end %>
</div>
